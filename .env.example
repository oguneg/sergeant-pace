GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-3.8-flash

# Production only (docker compose): the public domain, and optional spending limits.
# DOMAIN=pace.ogun.se
# Defaults in docker-compose.yml suit a free-tier key. Raise these on a paid plan.
# SP_DAILY_COACH=60         # coach turns per day for the whole site, then "off duty" until midnight UTC
# SP_DAILY_SPEAK=40         # text-to-speech clips per day
# SP_DAILY_TRANSCRIBE=20    # voice-input transcriptions per day
# SP_RATE_COACH=15          # per visitor IP, per 10 minutes
